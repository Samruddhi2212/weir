# Copy to .env and adjust as needed. .env itself is gitignored - never
# commit real credentials, even local-dev ones, as a matter of habit.
#
# Every value below is a local-dev default already baked into docker-
# compose.yml / scripts/smoke_test.sh as a fallback. Setting .env only
# matters if you want something different from that default.

# ------------------------------------------------------------
# Kafka
# ------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Separate listener for host-side Python clients (scripts/
# produce_events.py, ingestion/replay/replay_producer.py). KAFKA_PORT's
# listener is advertised as kafka:9092 - a hostname that only resolves
# inside the weir-network, so a client running on the host itself can't
# follow Kafka's own metadata response back to it. See DEFENSE.md #34.
KAFKA_EXTERNAL_PORT=29092

# ------------------------------------------------------------
# PostgreSQL (Iceberg catalog metadata store)
# ------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=weir_catalog
POSTGRES_USER=weir
POSTGRES_PASSWORD=weir

# ------------------------------------------------------------
# SeaweedFS (S3-compatible object store)
# ------------------------------------------------------------
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888

# SeaweedFS is started with no -s3.config identity file baked in (see
# docker-compose.yml); scripts/smoke_test.sh instead configures this exact
# identity live, via `weed shell`'s `s3.configure`, right after the stack
# reports healthy - see DEFENSE.md #24. An earlier version of this comment
# claimed SeaweedFS "accepts any access key/secret pair" with no identity
# configured at all - that was wrong, never actually backed by a signed S3
# write reaching it (see DEFENSE.md #24 for the correction). Substituted
# into scripts/sql/smoke_step5.sql's sentinel tokens at runtime by
# scripts/smoke_test.sh's step 5, via the same make_readable_tmp() helper
# discussed in DEFENSE.md #10.
WEIR_S3_ACCESS_KEY=admin
WEIR_S3_SECRET_KEY=password123

# ------------------------------------------------------------
# Iceberg REST Catalog
# ------------------------------------------------------------
# Added after 5/5 reproducible CI failures showed Iceberg's Flink
# integration never supports catalog-type=jdbc, only hive/hadoop/rest -
# see DEFENSE.md #21. Metadata still lives in Postgres (the REST server's
# own CATALOG_URI); Flink now talks to it over REST instead of opening a
# JDBC connection directly.
ICEBERG_REST_PORT=8181

# ------------------------------------------------------------
# Flink
# ------------------------------------------------------------
FLINK_JOBMANAGER_UI_PORT=8081
FLINK_JOBMANAGER_RPC_PORT=6123

# Checkpoint interval, read via FLINK_PROPERTIES in docker-compose.yml.
# 60s chosen for file sizing/recovery window, not detection latency - see
# DEFENSE.md #1. Exists as an env var specifically so the (deferred)
# sensitivity sweep can vary it without editing config/flink/config.yaml.
WEIR_CHECKPOINT_INTERVAL=60s

# ------------------------------------------------------------
# Step 6: exactly-once validation (scripts/verify_recovery.sh,
# scripts/produce_events.py, scripts/sql/exactly_once_job.sql)
# ------------------------------------------------------------
# Session-scoped override of execution.checkpointing.interval AND
# execution.checkpointing.min-pause for that one job only - never touches
# the cluster-wide WEIR_CHECKPOINT_INTERVAL default above. See DEFENSE.md
# #28 for why min-pause has to move with it, not just the interval.
WEIR_EOS_CHECKPOINT_INTERVAL=10s
WEIR_EOS_TOPIC=weir-eos-events
WEIR_EOS_EVENTS_PER_SEC=100
